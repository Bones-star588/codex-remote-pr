# Public URL used for link generation and origin checks. Keep empty during local development.
PUBLIC_ORIGIN=

# Local listener. Cloudflare Tunnel should connect to this address.
HOST=127.0.0.1
PORT=4545

# Optional secondary HTTP listener for a trusted LAN/VPN. 0 disables it.
# Configure and open the local firewall with npm run setup:lan.
LAN_PORT=0
# Optional preferred local IPv4 address shown in the connection menu.
LAN_ADDRESS=

# Optional explicit path to the Codex desktop bundled CLI.
# Leave empty to auto-detect the supported Codex / ChatGPT installation.
CODEX_BINARY=

# Optional Codex home. Defaults to the current user's ~/.codex.
CODEX_HOME=

# Optional working directory used by new threads when no project is selected.
CODEX_WORKDIR=

# Local Chromium DevTools port exposed by the Codex desktop host.
CODEX_DESKTOP_DEBUG_PORT=9229

# Optional comma-separated origin allowlist. PUBLIC_ORIGIN is always included.
ALLOWED_ORIGINS=

# Set to 1 when running behind Cloudflare Tunnel or another trusted reverse proxy.
TRUST_PROXY=1

# Session lifetime in days.
SESSION_DAYS=30
